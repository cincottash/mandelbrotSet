// Iterates every pixel of one tile as an offset from the reference orbit (perturbation), skipping ahead with the
// bilinear approximation table where it is valid, and writes the raw results the coloring pass reads.
// "#version 430 core" and the tier define (TIER_X for zooms past single precision) are prepended by the program.

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) uniform writeonly image2D uOut0;   // mu (-1 inside), distance (px), normal.xy
layout(rgba32f, binding = 1) uniform writeonly image2D uOut1;   // |z| when it first passed 2, angle, stripes, inside value

layout(std430, binding = 0) readonly buffer RefF { vec4 refF[]; };   // Z as a high part (xy) and a low part (zw)
struct RefXEntry { vec4 m; ivec4 e; };                                // (high xy, low zw) * 2^e.x
layout(std430, binding = 1) readonly buffer RefX { RefXEntry refX[]; };
struct BlaFEntry { vec4 ab; vec4 r; };
layout(std430, binding = 2) readonly buffer BlaF { BlaFEntry blaF[]; };
struct BlaXEntry { vec4 ab; ivec2 e; float log2R; float pad; };
layout(std430, binding = 3) readonly buffer BlaX { BlaXEntry blaX[]; };
layout(std430, binding = 4) buffer Stats {
    uint maxN; uint maxIdx; uint glitches; uint nearMax; uint escaped; uint maxEscN; uint inside; uint unfinished;
} stats;
// A pixel that needs more iterations than one dispatch may run saves where it is here and goes on in the next
// dispatch, so no single dispatch runs long enough for the graphics driver to reset (Windows allows about 2 s).
// Five vec4 per pixel, in the tile's own slot (several tiles run together).
layout(std430, binding = 5) buffer State { vec4 st[]; };
// Inside-the-set boxing: 1 for each block whose whole border is inside the set. The set of points that haven't
// escaped after N iterations has no holes (an escape lemniscate), so everything the border encloses is inside too.
layout(std430, binding = 6) readonly buffer Blocks { uint blockInside[]; };

uniform ivec2 uOrigin;
uniform ivec2 uTileSize;
uniform ivec2 uSize;
uniform float uInvHalfH;
uniform float uHalfH;
uniform vec2 uRot;
uniform vec2 uJitter;
uniform float uScaleM;
uniform int uScaleE;
uniform vec2 uOffM;
uniform int uOffE;
uniform int uMaxIter;
uniform float uBailout2;
uniform float uLogBailout;
uniform int uRefLen;
uniform bool uRefEscaped;
uniform int uPower;
uniform int uFormula;         // 0 classic, 1 Burning Ship, 2 Tricorn (tier F only; the wide tier is classic power 2)
uniform bool uJulia;
uniform int uBlaLevels;
uniform int uBlaOffset[32];
uniform int uBlaCount[32];
uniform bool uStripe;
uniform float uStripeDensity;
// Orbit trap: the closest the orbit comes to a shape (-1 off, 0 point, 1 cross, 2 circle), kept where the stripes
// average would be (the two styles never run together).
uniform int uTrap;
uniform vec2 uTrapC;
uniform float uTrapR;

float trapDist(vec2 z)
{
    vec2 d = z - uTrapC;
    if (uTrap == 0) return length(d);
    if (uTrap == 1) return min(abs(d.x), abs(d.y));
    return abs(length(d) - uTrapR);
}
uniform int uIterBudget;      // iterations a pixel may run in this dispatch
uniform bool uResume;         // go on from the saved state (a later dispatch of the same tile)
uniform int uStateBase;       // the tile's first pixel slot in the state buffer
uniform int uPixelSet;        // 0 every pixel; boxing: 1, 2, 3 (see main)
uniform int uBlockBase;       // the tile's first entry in blockInside (4 big blocks, then 64 small ones)
uniform bool uShallowCheck;   // shallow Mandelbrot views: the main cardioid and the period-2 disk are inside outright
uniform vec2 uRefC;           // the reference point, for that check

const int BLOCK1 = 64, BLOCK2 = 16;

bool onBlockBorder(ivec2 local, int size)
{
    ivec2 lo = (local / size) * size;
    ivec2 hi = min(min(lo + size, uTileSize), uSize - uOrigin) - 1;
    return local.x == lo.x || local.y == lo.y || local.x == hi.x || local.y == hi.y;
}
bool blockFlag(ivec2 local, int size, int first)
{
    ivec2 b = local / size;
    return blockInside[uBlockBase + first + b.y * ((uTileSize.x + size - 1) / size) + b.x] != 0u;
}

const int ZERO_E = -1000000000;
const float BIG = 1.0e30;

vec2 cmul(vec2 a, vec2 b) { return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }

// x * 2^e for any e, without the undefined results ldexp gives outside -126..127.
float ldx(float x, int e)
{
    e = clamp(e, -252, 252);
    int h = e / 2;
    return ldexp(ldexp(x, h), e - h);
}
vec2 ldx(vec2 x, int e)
{
    e = clamp(e, -252, 252);
    int h = e / 2;
    return ldexp(ldexp(x, ivec2(h)), ivec2(e - h));
}
float infNorm(vec2 v) { return max(abs(v.x), abs(v.y)); }

// Complex numbers with their own power-of-two exponent: m * 2^e, max(|m.x|, |m.y|) in [0.5, 1).
struct FC { vec2 m; int e; };
FC fcZero() { return FC(vec2(0.0), ZERO_E); }
bool fcIsZero(FC a) { return a.e == ZERO_E; }
FC fcNorm(vec2 m, int e)
{
    float mx = infNorm(m);
    if (mx == 0.0 || e == ZERO_E) return fcZero();
    int k;
    frexp(mx, k);
    return FC(ldx(m, -k), e + k);
}
FC fcMul(FC a, FC b)
{
    if (fcIsZero(a) || fcIsZero(b)) return fcZero();
    return fcNorm(cmul(a.m, b.m), a.e + b.e);
}
FC fcAdd(FC a, FC b)
{
    if (fcIsZero(a)) return b;
    if (fcIsZero(b)) return a;
    int d = a.e - b.e;
    if (d > 60) return a;
    if (d < -60) return b;
    if (d >= 0) return fcNorm(a.m + ldx(b.m, -d), a.e);
    return fcNorm(ldx(a.m, d) + b.m, b.e);
}
vec2 fcToVec(FC a) { return fcIsZero(a) ? vec2(0.0) : ldx(a.m, a.e); }
float fcLog2(FC a) { return fcIsZero(a) ? -BIG : 0.5 * log2(dot(a.m, a.m)) + float(a.e); }
FC refXv(int i)
{
    RefXEntry r = refX[i];
    return (r.e.x <= -(1 << 29)) ? fcZero() : FC(r.m.xy, r.e.x);
}
vec2 refXf(int i)
{
    RefXEntry r = refX[i];
    return ldx(r.m.xy, r.e.x);
}

// A rebase goes back to the start of the reference orbit: the new offset is the whole z = Z + dz less the orbit's
// first value (0 for the Mandelbrot set; the reference point for a Julia set). Z's low part is added after the
// cancelling sum, so a small result keeps its digits.
vec2 rebaseF(int i, vec2 dz)
{
    vec4 R = refF[i];
    vec2 z = (R.xy + dz) + R.zw;
    if (uJulia) {
        vec4 R0 = refF[0];
        z = (z - R0.xy) - R0.zw;
    }
    return z;
}
FC rebaseX(int i, FC dz)
{
    RefXEntry r = refX[i];
    FC z = r.e.x <= -(1 << 29) ? dz : fcAdd(fcAdd(FC(r.m.xy, r.e.x), dz), fcNorm(r.m.zw, r.e.x));
    if (uJulia) {
        RefXEntry r0 = refX[0];
        if (r0.e.x > -(1 << 29)) z = fcAdd(fcAdd(z, FC(-r0.m.xy, r0.e.x)), fcNorm(-r0.m.zw, r0.e.x));
    }
    return z;
}
vec2 rebaseXF(int i, vec2 dz)
{
    RefXEntry r = refX[i];
    vec2 z = (ldx(r.m.xy, r.e.x) + dz) + ldx(r.m.zw, r.e.x);
    if (uJulia) {
        RefXEntry r0 = refX[0];
        z = (z - ldx(r0.m.xy, r0.e.x)) - ldx(r0.m.zw, r0.e.x);
    }
    return z;
}

shared uint sMaxN, sMaxIdx, sGlitch, sNear, sEsc, sMaxEsc, sInside;

// |c + d| - |c|, by cases, exact when d is tiny next to c.
float diffabs(float c, float d)
{
    float cd = c + d;
    if (c >= 0.0) return cd >= 0.0 ? d : -(2.0 * c + d);
    return cd > 0.0 ? 2.0 * c + d : -d;
}

float binom(int nn, int k)
{
    float r = 1.0;
    for (int i = 1; i <= k; ++i) r = r * float(nn - k + i) / float(i);
    return r;
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        sMaxN = 0u; sMaxIdx = 0u; sGlitch = 0u; sNear = 0u; sEsc = 0u; sMaxEsc = 0u; sInside = 0u;
    }
    barrier();

    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    ivec2 p = uOrigin + local;
    bool inTile = local.x < uTileSize.x && local.y < uTileSize.y && p.x < uSize.x && p.y < uSize.y;

    // Boxing in two sizes: 1) the borders of 64-pixel blocks; 2) the borders of 16-pixel blocks inside the big blocks
    // that weren't all inside; 3) the rest, filled where an enclosing block's border was all inside.
    bool boxedInside = false;
    if (inTile && uPixelSet != 0) {
        const bool on1 = onBlockBorder(local, BLOCK1), on2 = onBlockBorder(local, BLOCK2);
        const bool in1 = !on1 && uPixelSet >= 2 && blockFlag(local, BLOCK1, 0);
        if (uPixelSet == 1) inTile = on1;
        else if (uPixelSet == 2) inTile = !on1 && on2 && !in1;
        else {
            inTile = !on1 && (!on2 || in1);
            boxedInside = in1 || (!on2 && blockFlag(local, BLOCK2, 4));
        }
    }

    int n = 0;
    bool glitch = false;
    bool inside = true;
    float r2 = 0.0;
    vec2 z = vec2(0.0);
    vec2 Dm = vec2(0.0);
    vec2 Dm2 = vec2(0.0);   // the second column (Burning Ship and Tricorn only), same exponent De
    int De = uScaleE;
    float firstR = 0.0;
    float minR2 = BIG;
    float stripe = uTrap >= 0 ? BIG : 0.0, stripePrev = 0.0;
    int stripeCount = 0;
    bool finished = true;   // false: the budget ran out first; the state is saved for the next dispatch
    bool skip = false;      // finished in an earlier dispatch of this tile: nothing to do
    const int si = (uStateBase + local.y * uTileSize.x + local.x) * 5;

    if (inTile) {
        vec2 q =(vec2(p) + 0.5 + uJitter - 0.5 * vec2(uSize)) * uInvHalfH;
        q.y = -q.y;
        vec2 qr = vec2(q.x * uRot.x - q.y * uRot.y, q.x * uRot.y + q.y * uRot.x);
        // The derivative is kept as Dm * 2^De; dc/dq = rotation * scale.
        vec2 Dadd = uRot * uScaleM;
        // The Burning Ship and the Tricorn don't keep angles, so their derivative needs the second column too
        // (along the screen's other direction); the classic formula's is i times the first.
        vec2 Dadd2 = vec2(-Dadd.y, Dadd.x);
        if (uJulia) {
            Dm = Dadd;
            if (uFormula != 0) Dm2 = Dadd2;
        }
        int m = 0;
        int p1 = uPower - 1;

#ifdef TIER_X
        FC dcX = fcAdd(FC(uOffM, uOffE), fcMul(fcNorm(qr, 0), FC(vec2(uScaleM, 0.0), uScaleE)));
        FC dzX = uJulia ? dcX : fcZero();
        FC cX = uJulia ? fcZero() : dcX;
        vec2 cF = fcToVec(cX);
        vec2 dzF = vec2(0.0);
        bool wide = true;   // dz is held with its own exponent while it is too small for a plain float
        FC zX = fcAdd(refXv(0), dzX);
        z = fcToVec(zX);
#else
        vec2 dc = ldx(uOffM, uOffE) + qr * ldx(uScaleM, uScaleE);
        vec2 dz = uJulia ? dc : vec2(0.0);
        vec2 c = uJulia ? vec2(0.0) : dc;
        z = refF[0].xy + dz;
        if (uShallowCheck) {
            // Inside the main cardioid or the period-2 disk: inside for sure, no iterations needed.
            vec2 cc = uRefC + dc;
            float x = cc.x - 0.25, q = x * x + cc.y * cc.y;
            if (q * (q + x) < 0.25 * cc.y * cc.y || (cc.x + 1.0) * (cc.x + 1.0) + cc.y * cc.y < 0.0625) boxedInside = true;
        }
#endif
        r2 = dot(z, z);

        if (uResume) {
            const int flags = floatBitsToInt(st[si + 3].w);
            if ((flags & 2) != 0) skip = true;
            vec4 s0 = st[si], s1 = st[si + 1], s2 = st[si + 2], s3 = st[si + 3];
            Dm = s0.zw;
            z = s1.xy;
            firstR = s1.z;
            minR2 = s1.w;
            stripe = s2.x;
            stripePrev = s2.y;
            stripeCount = floatBitsToInt(s2.z);
            r2 = s2.w;
            m = floatBitsToInt(s3.x);
            n = floatBitsToInt(s3.y);
            De = floatBitsToInt(s3.z);
            glitch = (flags & 1) != 0;
#ifdef TIER_X
            dzF = s0.xy;
            vec4 s4 = st[si + 4];
            dzX = FC(s4.xy, floatBitsToInt(s4.z));
            wide = floatBitsToInt(s4.w) != 0;
#else
            dz = s0.xy;
            Dm2 = st[si + 4].xy;
#endif
        }
        if (boxedInside && !skip) n = uMaxIter;   // enclosed by inside pixels: inside, without iterating
        const int nStop = skip ? n : min(uMaxIter, n + uIterBudget);

        while (n < nStop) {
            // 1. Skip ahead with the table while the offset is small enough.
            if (uBlaLevels > 0 && m > 0 && ((m - 1) & 1) == 0) {
                int base = m - 1;
                int kTop = base == 0 ? uBlaLevels : min(findLSB(base), uBlaLevels);
                int found = 0;
#ifdef TIER_X
                float ldz = wide ? fcLog2(dzX) : log2(max(length(dzF), 1.0e-38));
                for (int k = 1; k <= kTop; ++k) {
                    int j = base >> k;
                    if (j >= uBlaCount[k - 1] || n + (1 << k) > uMaxIter) break;
                    if (!(ldz < blaX[uBlaOffset[k - 1] + j].log2R)) break;
                    found = k;
                }
                if (found > 0) {
                    BlaXEntry b = blaX[uBlaOffset[found - 1] + (base >> found)];
                    FC A = (b.e.x <= -(1 << 29)) ? fcZero() : FC(b.ab.xy, b.e.x);
                    FC B = (b.e.y <= -(1 << 29)) ? fcZero() : FC(b.ab.zw, b.e.y);
                    if (!wide) { dzX = fcNorm(dzF, 0); wide = true; }
                    dzX = fcAdd(fcMul(A, dzX), fcMul(B, cX));
                    // D' = A D + B dc/dq
                    if (!fcIsZero(A)) {
                        vec2 dm = cmul(A.m, Dm);
                        int ne = De + A.e;
                        if (!uJulia && !fcIsZero(B)) dm += ldx(cmul(B.m, Dadd), B.e + uScaleE - ne);
                        Dm = dm;
                        De = ne;
                    } else {
                        Dm = (uJulia || fcIsZero(B)) ? vec2(0.0) : cmul(B.m, Dadd);
                        De = B.e + uScaleE;
                    }
                    int len = 1 << found;
                    m += len;
                    n += len;
                    zX = fcAdd(refXv(m), dzX);
                    z = fcToVec(zX);
                    r2 = dot(z, z);
                    if (r2 > uBailout2) { inside = false; break; }
                    minR2 = min(minR2, r2);
                    if (uTrap >= 0) stripe = min(stripe, trapDist(z));
                    if (fcLog2(zX) < fcLog2(dzX) || m >= uRefLen) {
                        if (m >= uRefLen && uRefEscaped) glitch = true;
                        dzX = rebaseX(m, dzX);
                        m = 0;
                    }
                    if (dzX.e > -50) { dzF = fcToVec(dzX); wide = false; }
                    continue;
                }
#else
                float dzi = infNorm(dz);
                for (int k = 1; k <= kTop; ++k) {
                    int j = base >> k;
                    if (j >= uBlaCount[k - 1] || n + (1 << k) > uMaxIter) break;
                    if (!(dzi < blaF[uBlaOffset[k - 1] + j].r.x)) break;
                    found = k;
                }
                if (found > 0) {
                    vec4 ab = blaF[uBlaOffset[found - 1] + (base >> found)].ab;
                    dz = cmul(ab.xy, dz) + cmul(ab.zw, c);
                    Dm = cmul(ab.xy, Dm) + (uJulia ? vec2(0.0) : cmul(ab.zw, ldx(Dadd, uScaleE - De)));
                    int len = 1 << found;
                    m += len;
                    n += len;
                    z = refF[m].xy + dz;
                    r2 = dot(z, z);
                    if (r2 > uBailout2) { inside = false; break; }
                    minR2 = min(minR2, r2);
                    if (uTrap >= 0) stripe = min(stripe, trapDist(z));
                    if (infNorm(z) < infNorm(dz) || m >= uRefLen) {
                        if (m >= uRefLen && uRefEscaped) glitch = true;
                        dz = rebaseF(m, dz);
                        m = 0;
                    }
                    float dmx = infNorm(Dm);
                    if (dmx > 1.0e12) { Dm = ldx(Dm, -40); De += 40; }
                    else if (dmx < 1.0e-12 && dmx > 0.0) { Dm = ldx(Dm, 40); De -= 40; }
                    continue;
                }
#endif
            }

            // 2. One ordinary step. The derivative first, with z before the step: D' = p z^(p-1) D + dc/dq.
            if (uFormula == 1) {
                // Burning Ship: the Jacobian of (x^2 - y^2, 2|xy|) applied to both columns; c's imaginary part
                // enters negated.
                float sg = z.x * z.y >= 0.0 ? 1.0 : -1.0;
                Dm = 2.0 * vec2(z.x * Dm.x - z.y * Dm.y, sg * (z.y * Dm.x + z.x * Dm.y));
                Dm2 = 2.0 * vec2(z.x * Dm2.x - z.y * Dm2.y, sg * (z.y * Dm2.x + z.x * Dm2.y));
                if (!uJulia) {
                    vec2 a = ldx(Dadd, uScaleE - De), b = ldx(Dadd2, uScaleE - De);
                    Dm += vec2(a.x, -a.y);
                    Dm2 += vec2(b.x, -b.y);
                }
            } else {
                vec2 zp1 = z;
                for (int k = 1; k < p1; ++k) zp1 = cmul(zp1, z);
                vec2 t = float(uPower) * cmul(zp1, Dm);
                if (uFormula == 2) {
                    // Tricorn: D' = p conj(z^(p-1) D) + dc/dq, for both columns.
                    t.y = -t.y;
                    vec2 t2 = float(uPower) * cmul(zp1, Dm2);
                    Dm2 = vec2(t2.x, -t2.y) + (uJulia ? vec2(0.0) : ldx(Dadd2, uScaleE - De));
                }
                Dm = t + (uJulia ? vec2(0.0) : ldx(Dadd, uScaleE - De));
            }
            float dmx = max(infNorm(Dm), infNorm(Dm2));
            if (dmx > 1.0e12) { Dm = ldx(Dm, -40); Dm2 = ldx(Dm2, -40); De += 40; }
            else if (dmx < 1.0e-12 && dmx > 0.0) { Dm = ldx(Dm, 40); Dm2 = ldx(Dm2, 40); De -= 40; }

#ifdef TIER_X
            if (wide) {
                FC Z = refXv(m);
                FC twoZ = fcIsZero(Z) ? Z : FC(Z.m, Z.e + 1);
                dzX = fcAdd(fcMul(fcAdd(twoZ, dzX), dzX), cX);
                ++m; ++n;
                zX = fcAdd(refXv(m), dzX);
                z = fcToVec(zX);
                r2 = dot(z, z);
                if (r2 > uBailout2) { inside = false; break; }
                if (fcLog2(zX) < fcLog2(dzX) || m >= uRefLen) {
                    if (m >= uRefLen && uRefEscaped) glitch = true;
                    dzX = rebaseX(m, dzX);
                    m = 0;
                }
                if (dzX.e > -50) { dzF = fcToVec(dzX); wide = false; }
            } else {
                vec2 Z = refXf(m);
                dzF = cmul(2.0 * Z + dzF, dzF) + cF;
                ++m; ++n;
                z = refXf(m) + dzF;
                r2 = dot(z, z);
                if (r2 > uBailout2) { inside = false; break; }
                if (infNorm(z) < infNorm(dzF) || m >= uRefLen) {
                    if (m >= uRefLen && uRefEscaped) glitch = true;
                    dzF = rebaseXF(m, dzF);
                    m = 0;
                }
                if (infNorm(dzF) < 8.7e-19) { dzX = fcNorm(dzF, 0); wide = true; }   // below 2^-60
            }
#else
            vec2 Z = refF[m].xy;
            if (uFormula == 1) {
                // Burning Ship: x' = 2Xx + x^2 - 2Yy - y^2 + cx; y' = 2 (|XY + d| - |XY|) - cy with d = Xy + xY + xy,
                // the difference of absolute values worked out by cases so no digits cancel.
                float nx = (2.0 * Z.x + dz.x) * dz.x - (2.0 * Z.y + dz.y) * dz.y + c.x;
                float ny = 2.0 * diffabs(Z.x * Z.y, Z.x * dz.y + dz.x * Z.y + dz.x * dz.y) - c.y;
                dz = vec2(nx, ny);
            } else if (uPower == 2) {
                vec2 d = cmul(2.0 * Z + dz, dz);
                if (uFormula == 2) d.y = -d.y;   // Tricorn: conj((Z + dz)^2 - Z^2)
                dz = d + c;
            } else {
                // (Z + dz)^p - Z^p = dz * sum_k C(p,k) Z^(p-k) dz^(k-1), by Horner's rule in dz.
                vec2 zpow[8];
                zpow[0] = vec2(1.0, 0.0);
                for (int k = 1; k < uPower; ++k) zpow[k] = cmul(zpow[k - 1], Z);
                vec2 acc = vec2(1.0, 0.0);
                for (int k = uPower - 1; k >= 1; --k) acc = cmul(acc, dz) + binom(uPower, k) * zpow[uPower - k];
                vec2 d = cmul(acc, dz);
                if (uFormula == 2) d.y = -d.y;
                dz = d + c;
            }
            ++m; ++n;
            z = refF[m].xy + dz;
            r2 = dot(z, z);
            if (r2 > uBailout2) { inside = false; break; }
            if (infNorm(z) < infNorm(dz) || m >= uRefLen) {
                if (m >= uRefLen && uRefEscaped) glitch = true;
                dz = rebaseF(m, dz);
                m = 0;
            }
#endif
            if (firstR == 0.0 && r2 > 4.0) firstR = sqrt(r2);
            minR2 = min(minR2, r2);
            if (uTrap >= 0) stripe = min(stripe, trapDist(z));
            if (uStripe) {
                stripePrev = stripe;
                float s = 0.5 + 0.5 * sin(uStripeDensity * atan(z.y, z.x));
                stripe = stripeCount == 0 ? s : mix(stripe, s, 0.2);
                ++stripeCount;
            }
        }
        if (firstR == 0.0 && r2 > 4.0) firstR = sqrt(r2);
        if (!skip && inside && n < uMaxIter) {
            // Out of budget: save where this pixel is, for the next dispatch.
            finished = false;
            int flags = glitch ? 1 : 0;
#ifdef TIER_X
            st[si] = vec4(dzF, Dm);
            st[si + 4] = vec4(dzX.m, intBitsToFloat(dzX.e), intBitsToFloat(wide ? 1 : 0));
#else
            st[si] = vec4(dz, Dm);
            st[si + 4] = vec4(Dm2, 0.0, 0.0);
#endif
            st[si + 1] = vec4(z, firstR, minR2);
            st[si + 2] = vec4(stripe, stripePrev, intBitsToFloat(stripeCount), r2);
            st[si + 3] = vec4(intBitsToFloat(m), intBitsToFloat(n), intBitsToFloat(De), intBitsToFloat(flags));
            atomicAdd(stats.unfinished, 1u);
        } else if (!skip) {
            st[si + 3].w = intBitsToFloat(2);   // done: later dispatches of this tile leave it alone
        }
    }

    const bool report = inTile && !skip && finished;
    if (report) {
        vec4 o0, o1;
        if (inside) {
            o0 = vec4(-1.0, 0.0, 0.0, 0.0);
            o1 = vec4(0.0, atan(z.y, z.x), 0.0, sqrt(minR2));
        } else {
            float lz = 0.5 * log(r2);
            float mu = float(n) - log2(max(lz / uLogBailout, 1.0e-6)) / log2(float(uPower));
            // The potential's gradient over the screen is (D1 . z, D2 . z) / |z|^2; for the classic formula that is
            // z conj(D) / |z|^2, since D2 = i D1.
            vec2 u = uFormula == 0 ? cmul(z, vec2(Dm.x, -Dm.y)) : vec2(dot(Dm, z), dot(Dm2, z));
            float lenD = uFormula == 0 ? length(Dm) : length(u) / max(sqrt(r2), 1.0e-30);
            float l2de = log2(sqrt(r2) * lz * uHalfH / max(lenD, 1.0e-30)) - float(De);
            float de = exp2(clamp(l2de, -60.0, 60.0));
            float ul = length(u);
            vec2 nrm = ul > 0.0 ? u / ul : vec2(0.0);
            float stripeV = uTrap >= 0 ? stripe : mix(stripePrev, stripe, clamp(fract(mu), 0.0, 1.0));
            o0 = vec4(mu, de, nrm);
            o1 = vec4(firstR, atan(z.y, z.x), stripeV, 0.0);
        }
        imageStore(uOut0, p, o0);
        imageStore(uOut1, p, o1);

        uint un = uint(n);
        atomicMax(sMaxN, un);
        if (glitch) atomicAdd(sGlitch, 1u);
        if (inside) atomicAdd(sInside, 1u);
        else {
            atomicAdd(sEsc, 1u);
            atomicMax(sMaxEsc, un);
            if (n * 2 > uMaxIter) atomicAdd(sNear, 1u);
        }
    }
    barrier();
    if (report) {
        // One pixel of the group that reached the most iterations names a spot for a better reference.
        if (uint(n) == sMaxN) atomicExchange(sMaxIdx, uint(p.y * uSize.x + p.x));
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && sMaxN > 0u) {
        uint old = atomicMax(stats.maxN, sMaxN);
        if (sMaxN > old) stats.maxIdx = sMaxIdx;
        if (sGlitch > 0u) atomicAdd(stats.glitches, sGlitch);
        if (sNear > 0u) atomicAdd(stats.nearMax, sNear);
        if (sEsc > 0u) atomicAdd(stats.escaped, sEsc);
        if (sInside > 0u) atomicAdd(stats.inside, sInside);
        atomicMax(stats.maxEscN, sMaxEsc);
    }
}
